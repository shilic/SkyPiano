<Window x:Class="SkyPiano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SkyPiano.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="SkyPiano" Height="420" Width="550" MinHeight="350" MinWidth="450"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">
    <!--
        顶部的 xmlns 是 WPF 的命名空间声明（XML Namespace）：
        xmlns="http://..."        默认命名空间，包含所有 WPF 控件（Button、Grid、TextBlock 等）
        xmlns:x="http://..."      XAML 语言特性命名空间，提供 x:Key、x:Class、x:Type 等
        xmlns:d="http://..."      设计时命名空间，只在 Visual Studio 设计器中工作，运行时完全忽略
        xmlns:mc="http://..."     标记兼容性命名空间，用来告诉编译器哪些标记可以忽略
        xmlns:vm="clr-namespace:..."  引用 C# 命名空间，让 XAML 可以使用 ViewModel 类

        mc:Ignorable="d"  →  告诉编译器 "d:" 开头的属性只在设计时使用，运行时跳过

        x:Class="SkyPiano.MainWindow"  →  这个 XAML 对应哪个 C# 类（代码隐藏），
            编译时会生成一个 partial class 的 InitializeComponent() 方法

        WindowStartupLocation="CenterScreen"  →  窗口启动时显示在屏幕正中央

        Background="#1E1E2E"  →  #RRGGBB 格式的十六进制颜色，这里是 Catppuccin 深色主题底色
    -->

    <Window.DataContext>
        <!--
            DataContext 是 WPF 中最重要的概念之一 —— 数据上下文。
            窗口内所有控件的 {Binding ...} 都会从这个对象上查找属性。

            这里在 XAML 中直接创建 MainViewModel 实例并赋值给 DataContext，
            等价于代码隐藏中写: this.DataContext = new MainViewModel();

            放在 XAML 中的好处：代码隐藏文件保持极简，只处理生命周期。
            缺点是 MainViewModel 的构造函数如果有耗时操作（比如加载文件），也会在此时执行。

            注意：d:DataContext 在上面已经声明了设计时类型，所以 VS 设计器知道
            这个窗口的绑定源是 MainViewModel，能给出智能提示，但不会真正执行构造函数。
        -->
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!--
            Window.Resources 是 WPF 的"资源字典"——存放可复用的样式、画刷、模板、数据等。
            这里定义的所有 Style 只在本窗口内有效（局部资源），子窗口不会继承。

            每个 Style 需要一个 x:Key（名字），控件通过 StaticResource 引用：
            例如 Style="{StaticResource TransportButton}" 意思是"查找名为 TransportButton 的样式来用"

            StaticResource vs DynamicResource：
            - StaticResource 在窗口初始化时一次性查找并应用，之后不再变化，性能更好
            - DynamicResource 会持续监听资源变化（比如换肤场景），有额外开销
            这里所有样式都不会运行时修改，所以用 StaticResource
        -->

        <!--
            ===== IconButton：文件夹图标按钮样式 =====
            用途：顶部右上角的"切换 MIDI 文件夹"按钮。
            透明背景 + 小尺寸 + 圆角 + 悬停变色
        -->
        <Style x:Key="IconButton" TargetType="Button">
            <!--
                TargetType="Button" 告诉 WPF 这个 Style 只能用于 Button 控件
                Setters 在不指定 x:Key 的情况下会自动应用到所有 Button，这里指定了 Key 所以需要显式引用
            -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <!--
                    Template（ControlTemplate）可以完全重写控件的视觉效果。
                    WPF 的无外观特性（Lookless Controls）意味着 Button 的默认外观
                    只是 WPF 给你的一个"默认模板"，你可以通过重写 Template 彻底改变按钮长什么样。

                    下面的 ControlTemplate 把 Button 的视觉替换为一个带圆角的 Border + 文字居中

                    {TemplateBinding XXX} 只在 ControlTemplate 内部使用，
                    意思是"从使用此模板的 Button 控件身上读取 XXX 属性的值"
                    例如 {TemplateBinding Background} → 读取 Button 的 Background 属性（上面设为 Transparent）
                -->
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <!--
                                ContentPresenter 是"占位符"，用来显示 Button.Content 的内容。
                                没有 ContentPresenter 的话，你在 Button 标签之间写什么都不会显示。
                            -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!--
                    Trigger: 当指定属性的值匹配时，自动应用 Setters
                    这里是：鼠标悬停（IsMouseOver=True）时换背景色和文字颜色

                    Trigger 和 DataTrigger 的区别：
                    - Trigger 监听控件自身的依赖属性（如 IsMouseOver）
                    - DataTrigger 监听绑定的数据属性（如 ViewModel 的 IsPlaying）
                        后面播放列表的 ▶ 指示器和播放按钮图标切换就是 DataTrigger 的例子
                -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            ===== TransportButton：运输栏按钮样式 =====
            用途：上一首 ⏮、快退 ⏪、快进 ⏩、下一首 ⏭ 四个按钮
            比 IconButton 更大，深色圆角方块背景
        -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#585B70"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            ===== PlayButton：播放/暂停按钮样式 =====
            基于 TransportButton（BasedOn="{StaticResource TransportButton}"），
            继承其所有 Setter，只覆盖不同的属性。
            比运输按钮更大（56x56）、蓝色背景、更大字体。
        -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B4D0FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        ===== 主布局：Grid =====
        WPF 的 Grid 是最常用的布局容器，它可以定义多行多列来精确控制子元素的位置。
        Margin="10"  →  整个 Grid 四周留 10px 的空白边距（单位是设备无关像素）
    -->
    <Grid Margin="10">
        <!--
            RowDefinitions: 行定义
            Height 有三种值：
            - Auto →  高度由内容决定，内容多高就多高
            - *    →  占满剩余空间（比例，"剩余空间的全部"）
            - 数字 →  固定像素高度
            如果有多个 * 行：两个 * 就是各占 50%，三个就是各 33.3%
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!--  Row 0: 标题栏（曲名 + 文件夹按钮），内容多高就多高  -->
            <RowDefinition Height="*"/>       <!--  Row 1: 播放列表，占满剩余全部空间  -->
            <RowDefinition Height="Auto"/>   <!--  Row 2: 进度条区域，内容多高就多高  -->
            <RowDefinition Height="Auto"/>   <!--  Row 3: 运输控制按钮栏，内容多高就多高  -->
        </Grid.RowDefinitions>

        <!--  ===== Row 0: 标题栏 =====  -->
        <!--
            这一行内部也是一个 Grid（2 列布局），左边曲名，右边文件夹按钮
            Margin 的顺序是 左上右下
        -->
        <Grid Grid.Row="0" Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>       <!--  曲名占满左边剩余空间  -->
                <ColumnDefinition Width="Auto"/>   <!--  文件夹按钮宽度自适应  -->
            </Grid.ColumnDefinitions>

            <!--
                StackPanel: 将子元素水平或垂直排列
                Orientation="Horizontal"  →  水平排列（从左到右）
                VerticalAlignment="Center"  →  在本行中垂直居中
            -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    TextBlock: 纯文本显示控件（只读），不能编辑
                    {Binding CurrentTrackName}  →  从 DataContext（即 MainViewModel）
                        读取 CurrentTrackName 属性的值。WPF 会自动订阅 PropertyChanged 事件，
                        当属性值变化时文本自动更新，不需要手动操作 UI。

                    TextTrimming="CharacterEllipsis"  →  文本超出 MaxWidth 时末尾显示 "..."

                    FontWeight="SemiBold"  →  比 Bold 稍轻，比 Regular 稍重，视觉上更合适做标题
                -->
                <TextBlock Text="{Binding CurrentTrackName}" FontSize="15" FontWeight="SemiBold"
                           Foreground="#CDD6F4" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                <!--
                    曲目索引："3 / 12"
                    Margin="8,0,0,0"  →  左边留 8px 间距，与前一个 TextBlock 隔开
                -->
                <TextBlock Text="{Binding TrackIndex}" FontSize="12" Foreground="#A6ADC8"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!--
                文件夹选择按钮
                Grid.Column="1"  →  放在第 2 列（列索引从 0 开始）
                Command="{Binding SwitchFolderCommand}"  →  点击按钮时执行 ViewModel 的 SwitchFolderCommand 命令
                    这是 WPF 的 Command 模式——不用写 Click 事件，直接绑定命令，松耦合
                Content="&#x1F4C1;"  →  Unicode 转义，显示 📁 文件夹图标
                ToolTip  →  鼠标悬停时显示的提示文字
            -->
            <Button Grid.Column="1" Command="{Binding SwitchFolderCommand}"
                    Content="&#x1F4C1;" Style="{StaticResource IconButton}"
                    ToolTip="切换 MIDI 文件夹"/>
        </Grid>

        <!--
            ===== Row 1: 播放列表 =====
            ListBox 是 WPF 的列表控件，负责显示一列数据项。
            每个数据项通过 ItemTemplate 定义显示方式。
        -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding PlaylistItems}"
                 SelectedIndex="{Binding SelectedTrackIndex, Mode=TwoWay}"
                 Background="Transparent" BorderBrush="#45475A" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!--
                ItemsSource：列表的数据源。绑定到 ViewModel 的 PlaylistItems，
                它是一个 ObservableCollection<TrackItemViewModel>。
                ObservableCollection 会自动通知 ListBox 增删操作，不需要手动刷新。

                SelectedIndex：当前选中项的索引（0-based）。
                Mode=TwoWay 是双向绑定——
                用户点击列表 → 索引传给 ViewModel 的 SelectedTrackIndex 属性
                代码修改 SelectedTrackIndex → ListBox 自动滚动到对应位置
                （默认就是 TwoWay，这里显式写出来是为了强调）

                ScrollViewer.HorizontalScrollBarVisibility="Disabled" → 禁用横向滚动条，
                文件名过长时通过 TextTrimming 截断，而不是横向滚动
            -->
            <ListBox.ItemTemplate>
                <!--
                    ItemTemplate：每个列表项的"样子"。
                    DataType 指定了数据的类型，帮助 VS 设计器智能提示。
                    下面定义的是一行 Grid：左边 ▶ 指示器 + 右边文件名
                -->
                <DataTemplate DataType="{x:Type vm:TrackItemViewModel}">
                    <Grid Height="32" Margin="2,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>   <!--  播放指示器列（▶ 图标）  -->
                            <ColumnDefinition Width="*"/>       <!--  曲目名列  -->
                        </Grid.ColumnDefinitions>

                        <!--
                            ▶ 播放指示器

                            关键技巧：用 DataTrigger 控制 Visibility
                            - IsPlaying=True 时 Visible（显示 ▶）
                            - IsPlaying=False 时 Hidden（隐藏但保留占位，不挤动文字）

                            为什么用 Hidden 而不是 Collapsed？
                            Hidden 保留元素占用的空间，所以曲名位置不会因为有的曲目有 ▶ 而左右跳动。
                            Collapsed 会释放空间导致曲名左右平移，视觉体验很差。
                        -->
                        <TextBlock Grid.Column="0" Text="&#x25B6;" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#89B4FA">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            曲目文件名
                            默认灰色（#A6ADC8），当前播放曲目高亮蓝色（#89B4FA）+ 加粗
                        -->
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A6ADC8"/>  <!--  没在播放时灰色  -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="#89B4FA"/>   <!--  播放中亮蓝色  -->
                                            <Setter Property="FontWeight" Value="SemiBold"/> <!--  播放中加粗  -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--
            ===== Row 2: 进度条 =====
            三列布局：当前时间 | Slider 进度条 | 总时长
        -->
        <Grid Grid.Row="2" Margin="4,10,4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!--  当前时间 "01:23"  -->
                <ColumnDefinition Width="*"/>       <!--  Slider 占满剩余空间  -->
                <ColumnDefinition Width="Auto"/>   <!--  总时长 "04:56"  -->
            </Grid.ColumnDefinitions>

            <!--
                当前播放时间
                FontFamily="Consolas"  →  等宽字体，数字宽度一致不会左右跳动
                Margin="0,0,6,0"  →  右边留 6px 间距和 Slider 隔开
            -->
            <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" FontSize="12"
                       Foreground="#A6ADC8" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0"/>

            <!--
                Slider 进度条
                Minimum="0" Maximum="1"  →  范围是 0~1，与 Progress 的 0.0~1.0 对应
                Value="{Binding Progress, Mode=OneWay}"  →  单向绑定，显示但不接收用户输入
                IsEnabled="False"  →  禁用用户拖拽（只读显示，不接收鼠标交互）

                为什么是 Mode=OneWay？
                Progress 属性没有 setter（由定时器自动更新），不能双绑。
                Slider 默认是 TwoWay，不加 OneWay 会崩溃。
            -->
            <Slider Grid.Column="1" Minimum="0" Maximum="1"
                    Value="{Binding Progress, Mode=OneWay}"
                    VerticalAlignment="Center" IsEnabled="False"/>

            <!--  曲目总时长  -->
            <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="12"
                       Foreground="#A6ADC8" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>

        <!--
            ===== Row 3: 运输控制栏 =====
            StackPanel 水平排列 5 个按钮：⏮ ⏪ ▶/⏸ ⏩ ⏭
            HorizontalAlignment="Center"  →  在本行中水平居中
        -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">

            <!--  ⏮ 上一首  （Unicode 编码 U+23EE）  -->
            <Button Command="{Binding PrevCommand}" Content="&#x23EE;" Width="44" Height="44"
                    FontSize="18" Style="{StaticResource TransportButton}"/>

            <!--  ⏪ 快退 5 秒  -->
            <Button Command="{Binding RewindCommand}" Content="&#x23EA;" Width="44" Height="44"
                    FontSize="18" Margin="6,0" Style="{StaticResource TransportButton}"/>

            <!--
                ▶ / ⏸ 播放/暂停按钮（最大、最突出的按钮）

                不直接在 Button 上写 Content，而是通过 Style 中的 DataTrigger 动态切换图标：
                - 未播放时 → Content = ▶（&#x25B6;）
                - 正在播放 → Content = ⏸（&#x23F8;）

                因为 DataTrigger 绑定了 ViewModel 的 IsPlaying 属性，
                所以播放/暂停状态切换时图标会自动变化。

                之所以不在 Button.Content 上写 Binding + Converter，
                而是用 Style + DataTrigger：
                更直观，不需要额外写 IValueConverter 转换类。
            -->
            <Button Width="56" Height="56" FontSize="24" Margin="6,0"
                    Command="{Binding PlayPauseCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                        <Setter Property="Content" Value="&#x25B6;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Content" Value="&#x23F8;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!--  ⏩ 快进 5 秒  -->
            <Button Command="{Binding FastForwardCommand}" Content="&#x23E9;" Width="44" Height="44"
                    FontSize="18" Margin="6,0" Style="{StaticResource TransportButton}"/>

            <!--  ⏭ 下一首  （Unicode 编码 U+23ED）  -->
            <Button Command="{Binding NextCommand}" Content="&#x23ED;" Width="44" Height="44"
                    FontSize="18" Style="{StaticResource TransportButton}"/>
        </StackPanel>
    </Grid>
</Window>
