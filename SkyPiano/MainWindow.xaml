<Window x:Class="SkyPiano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SkyPiano.ViewModel"
        Title="SkyPiano" Height="500" Width="800" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#585B70"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B4D0FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Track Info -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,8">
            <TextBlock Text="{Binding CurrentTrackName}" FontSize="18" FontWeight="SemiBold"
                       Foreground="#CDD6F4" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TrackIndex}" FontSize="14" Foreground="#A6ADC8"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Row 1: Piano Keyboard -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding KeyViewModels}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:KeyNoteViewModel}">
                    <Border Width="34" Height="150" Margin="1,0" CornerRadius="0,0,4,4"
                            Background="#313244" BorderBrush="#45475A" BorderThickness="1,0,1,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#89B4FA"/>
                                        <Setter Property="BorderBrush" Value="#89B4FA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold"
                                   Foreground="#A6ADC8" VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Row 2: Progress -->
        <Grid Grid.Row="2" Margin="4,12,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" FontSize="13"
                       Foreground="#A6ADC8" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                    VerticalAlignment="Center" IsEnabled="False"/>
            <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="13"
                       Foreground="#A6ADC8" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- Row 3: Transport Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
            <Button Command="{Binding PrevCommand}" Content="&#x23EE;" Width="44" Height="44"
                    FontSize="18" Style="{StaticResource TransportButton}"/>
            <Button Command="{Binding RewindCommand}" Content="&#x23EA;" Width="44" Height="44"
                    FontSize="18" Margin="6,0" Style="{StaticResource TransportButton}"/>
            <Button Width="56" Height="56" FontSize="24" Margin="6,0"
                    Command="{Binding PlayPauseCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                        <Setter Property="Content" Value="&#x25B6;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Content" Value="&#x23F8;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding FastForwardCommand}" Content="&#x23E9;" Width="44" Height="44"
                    FontSize="18" Margin="6,0" Style="{StaticResource TransportButton}"/>
            <Button Command="{Binding NextCommand}" Content="&#x23ED;" Width="44" Height="44"
                    FontSize="18" Style="{StaticResource TransportButton}"/>
        </StackPanel>
    </Grid>

</Window>
