<Window x:Class="SkyPiano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SkyPiano.ViewModel"
        Title="SkyPiano" Height="420" Width="550" MinHeight="350" MinWidth="450"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#585B70"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B4D0FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Track Info + Folder Button -->
        <Grid Grid.Row="0" Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTrackName}" FontSize="15" FontWeight="SemiBold"
                           Foreground="#CDD6F4" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                <TextBlock Text="{Binding TrackIndex}" FontSize="12" Foreground="#A6ADC8"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 切换文件夹按钮 -->
            <Button Grid.Column="1" Command="{Binding SwitchFolderCommand}"
                    Content="&#x1F4C1;" Style="{StaticResource IconButton}"
                    ToolTip="切换 MIDI 文件夹"/>
        </Grid>

        <!-- Row 1: Playlist -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding PlaylistItems}"
                 SelectedIndex="{Binding SelectedTrackIndex, Mode=TwoWay}"
                 Background="Transparent" BorderBrush="#45475A" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TrackItemViewModel}">
                    <Grid Height="32" Margin="2,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 播放指示器 -->
                        <TextBlock Grid.Column="0" Text="&#x25B6;" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#89B4FA">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 曲目文件名 -->
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A6ADC8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="#89B4FA"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 2: Progress -->
        <Grid Grid.Row="2" Margin="2,10,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" FontSize="12"
                       Foreground="#A6ADC8" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                    VerticalAlignment="Center" IsEnabled="False"/>
            <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="12"
                       Foreground="#A6ADC8" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>

        <!-- Row 3: Transport Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
            <Button Command="{Binding PrevCommand}" Content="&#x23EE;" Width="38" Height="38"
                    FontSize="16" Style="{StaticResource TransportButton}"/>
            <Button Command="{Binding RewindCommand}" Content="&#x23EA;" Width="38" Height="38"
                    FontSize="16" Margin="4,0" Style="{StaticResource TransportButton}"/>
            <Button Width="48" Height="48" FontSize="22" Margin="4,0"
                    Command="{Binding PlayPauseCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                        <Setter Property="Content" Value="&#x25B6;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Content" Value="&#x23F8;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding FastForwardCommand}" Content="&#x23E9;" Width="38" Height="38"
                    FontSize="16" Margin="4,0" Style="{StaticResource TransportButton}"/>
            <Button Command="{Binding NextCommand}" Content="&#x23ED;" Width="38" Height="38"
                    FontSize="16" Style="{StaticResource TransportButton}"/>
        </StackPanel>
    </Grid>

</Window>
